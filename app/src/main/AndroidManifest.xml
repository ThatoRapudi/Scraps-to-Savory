<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.ScrapsToSavory"
        android:usesCleartextTraffic="false">

        <!-- Activities are added here one at a time as we build each screen
             (Pantry List, Add/Edit Ingredient, Suggested Recipes, Recipe Detail, Settings).
             Keeping this file growing step-by-step, rather than all at once,
             mirrors genuine incremental development for the Git history requirement. -->

        <activity
            android:name=".ui.PantryListActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.AddEditIngredientActivity"
            android:exported="false"
            android:parentActivityName=".ui.PantryListActivity" />

    </application>

</manifest>
